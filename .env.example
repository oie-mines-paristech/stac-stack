HTTP_PORT=8000

# Interface nginx listens on. `make up-tls` sets it to 127.0.0.1 automatically
# so Caddy becomes the only reachable entry point; override it here for any
# non-default case. Note that `docker compose --profile tls up` on its own does
# NOT set it: prefix BIND_ADDR=127.0.0.1 yourself.
BIND_ADDR=0.0.0.0

# --- Optional TLS terminator (compose profile `tls`) --------------------
# Only read when the profile is enabled: make up-tls
#
# DOMAIN  hostname Caddy answers for. Must resolve to this host — for a
#         local test add it to /etc/hosts:  127.0.0.1 stac.oie.local
# TLS     Caddy `tls` directive value:
#           internal           self-signed, offline, browsers warn
#           "acme you@host"   Let's Encrypt, needs public inbound 80/443
#                           and real DNS pointing at this host
# Declare DOMAIN before EXTERNAL_URL, which is derived from it.
DOMAIN=stac.mysite.com
TLS=internal

# Public entry point advertised in STAC items. Derived from DOMAIN; keep only
# one of the two lines. Without the `tls` profile the stack is reached over
# plain HTTP, so point it back at the nginx port:
# EXTERNAL_URL=http://localhost:${HTTP_PORT}/
EXTERNAL_URL=https://${DOMAIN}/

# nginx worker processes run as this host uid/gid so volumes/data is shared
# without changing ownership (here: rjolivet).
NGINX_UID=1000
NGINX_GID=1000

# WebDAV /data: read-only for everyone; PUT/MKCOL/DELETE/... require this admin.
# Leave empty to disable writes entirely.
WEBDAV_ADMIN=admin
WEBDAV_PASSWORD=changeme
