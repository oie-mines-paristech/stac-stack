HTTP_PORT=8000

# nginx worker processes run as this host uid/gid so volumes/data is shared
# without changing ownership (here: rjolivet).
NGINX_UID=1000
NGINX_GID=1000

# WebDAV /data: read-only for everyone; PUT/MKCOL/DELETE/... require this admin.
# Leave empty to disable writes entirely.
WEBDAV_ADMIN=admin
WEBDAV_PASSWORD=changeme

EXTERNAL_URL=https://stac.mysite.com/
