.DS_Store
.cache/
node_modules/
dist/
**/dist/
**/node_modules/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# JS / test outputs
test-results/
playwright-report/
coverage/
*.tsbuildinfo
output/

data/stac-index/*
data/*

# Docker volume mounts.
# volumes/data/ is committed: it holds the small example catalog that the
# stack serves out of the box. volumes/catalog/, volumes/cache/ and
# volumes/certificates/ are generated at runtime.
volumes/catalog/**
!volumes/catalog/.gitkeep
volumes/cache/**
!volumes/cache/.gitkeep
volumes/certificates/**
!volumes/certificates/.gitkeep

# local env files
.env
.env.local
.env.*.local

# E2E TLS test certificates
tests/certs/*.pem
tests/nginx/https-stac.generated.conf

# E2E WebDAV test data
tests/e2e-data/
tests/e2e-catalog/
tests/e2e-*.bin
tests/e2e-upload.txt

# lock files
/yarn.lock

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode/*
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwright-mcp/
