# HTTPS listener for E2E (self-signed cert from tests/certs, mounted via docker-compose.proxy.yml).
# Listen port equals the host-published port so $server_port / X-Forwarded-Port stay correct.

server {
    listen ${NGINX_HTTPS_PORT} default_server ssl;
    server_name localhost;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    types {
        application/javascript  js mjs;
        application/wasm        wasm;
        text/css                css;
        text/html               html;
    }

    location / {
        proxy_pass http://browser:8081/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://static-api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location /data/ {
        alias /data/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }
}