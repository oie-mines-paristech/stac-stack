map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}



# Sanitize upstream X-Forwarded-Host only (never synthesize from Host — that duplicates the port).
map $http_x_forwarded_host $forwarded_host {
    ""             "";
    "~^([^,\s:]+)" $1;
    default        $http_x_forwarded_host;
}

server {
    listen 8080;
    server_name  localhost;
    # Relative redirects so the client keeps the original host:port (e.g. :8000).
    absolute_redirect off;
    port_in_redirect off;

    include /etc/nginx/mime.types;

    types {
        application/javascript  js mjs;
        application/wasm        wasm;
        text/css                css;
        text/html               html;
    }

    location ${PATH_PREFIX}api/ {
        proxy_pass http://static-api/;
        # Preserve client host/port and HTTPS context for stac-fastapi-static.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    }

    location ${PATH_PREFIX}data/ {
        alias /data/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;

        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Range, Content-Type, Accept, Authorization, X-Requested-With" always;
        add_header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # Same-origin proxy for cross-origin Zarr stores (CORS bypass).
    # Matches /viewer/proxy/https/... and /any/prefix/viewer/proxy/https/...
    location ~ ^(/.*)?/proxy/(?<upstream_scheme>https?)/(?<upstream_host>[^/]+)(?<upstream_path>/.*)$ {
        resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Range" always;
            return 204;
        }

        set $upstream $upstream_scheme://$upstream_host$upstream_path$is_args$args;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $upstream_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Range $http_range;
        proxy_ssl_server_name on;
        proxy_buffering off;
    }

    location ${PATH_PREFIX}viewer/ {
        alias /usr/share/nginx/html/viewer/;
        index index.html;
        try_files $uri $uri/ ${PATH_PREFIX}viewer/index.html;
    }

    location = ${PATH_PREFIX}viewer/index.html {
        alias /usr/share/nginx/html/viewer/index.html;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    ${PATH_PREFIX_REDIRECT_BLOCK}

    location ${PATH_PREFIX} {
        alias  /usr/share/nginx/html/;
        index  index.html;
        try_files $uri $uri/ ${PATH_PREFIX}index.html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
