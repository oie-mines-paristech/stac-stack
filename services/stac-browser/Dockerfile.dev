ARG pathPrefix="/"

FROM node:lts-alpine3.18

RUN apk add --no-cache nginx jq gettext wget

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY config.schema.json /etc/nginx/conf.d/config.schema.json

RUN chmod +x /app/docker/dev-entrypoint.sh \
    && mkdir -p /usr/share/nginx/html/viewer /tmp \
    && chown -R nginx:nginx /usr/share/nginx/html /var/lib/nginx /var/log/nginx /run/nginx 2>/dev/null || true

EXPOSE 8080

ENV DEV=1
ENV STAC_BROWSER_DEV=1
ENV VUE_DEV_SERVER_PORT=8081
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

CMD ["/app/docker/dev-entrypoint.sh"]
